{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fvoci vocabulary v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "revision",
    "title",
    "languages",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "test_date": {
      "type": "string",
      "format": "date"
    },
    "languages": {
      "type": "object",
      "required": [
        "prompt",
        "answer"
      ],
      "properties": {
        "prompt": {
          "const": "de"
        },
        "answer": {
          "const": "fr"
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "de",
          "fr"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "other"
            ]
          },
          "de": {
            "type": "object",
            "required": [
              "prompt",
              "answers"
            ],
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "answers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "accept"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "accept": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "fr": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "forms"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "forms": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "additionalProperties": false
            }
          },
          "allow_self_override": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "related_entry_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "source": {
            "type": "object",
            "required": [
              "file"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "row": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "noun",
                    "adjective"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "fr": {
                  "items": {
                    "properties": {
                      "forms": {
                        "type": "object",
                        "minProperties": 1,
                        "properties": {
                          "m_sg": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "f_sg": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "m_pl": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "f_pl": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "verb"
                }
              }
            },
            "then": {
              "properties": {
                "fr": {
                  "items": {
                    "properties": {
                      "forms": {
                        "type": "object",
                        "minProperties": 1,
                        "properties": {
                          "infinitive": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.je": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.tu": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.il": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.nous": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.vous": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "present.ils": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "infinitive"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "other"
                }
              }
            },
            "then": {
              "properties": {
                "fr": {
                  "items": {
                    "properties": {
                      "forms": {
                        "type": "object",
                        "minProperties": 1,
                        "properties": {
                          "text": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "text"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "allow_self_override": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
